#!/usr/bin/env python3
import os
import struct
import sys
import zlib

THRESHOLD = 8


def read_png(path):
    with open(path, "rb") as f:
        raw = f.read()
    if raw[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    pos, idat, head = 8, [], None
    while pos < len(raw):
        size, kind = struct.unpack(">I4s", raw[pos : pos + 8])
        body = raw[pos + 8 : pos + 8 + size]
        pos += 12 + size
        if kind == b"IHDR":
            head = struct.unpack(">IIBBBBB", body)
        elif kind == b"IDAT":
            idat.append(body)
    w, h, depth, ctype, _, _, interlace = head
    channels = {0: 1, 2: 3, 4: 2, 6: 4}.get(ctype)
    if depth != 8 or channels is None or interlace:
        raise ValueError("only 8-bit, non-interlaced, non-palette PNG")
    data = zlib.decompress(b"".join(idat))
    stride = w * channels
    rows, prev = [], bytearray(stride)
    at = 0
    for _ in range(h):
        ft = data[at]
        cur = bytearray(data[at + 1 : at + 1 + stride])
        at += 1 + stride
        if ft == 1:
            for i in range(channels, stride):
                cur[i] = (cur[i] + cur[i - channels]) & 255
        elif ft == 2:
            for i in range(stride):
                cur[i] = (cur[i] + prev[i]) & 255
        elif ft == 3:
            for i in range(stride):
                left = cur[i - channels] if i >= channels else 0
                cur[i] = (cur[i] + ((left + prev[i]) >> 1)) & 255
        elif ft == 4:
            for i in range(stride):
                a = cur[i - channels] if i >= channels else 0
                b = prev[i]
                c = prev[i - channels] if i >= channels else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                pr = a if pa <= pb and pa <= pc else (b if pb <= pc else c)
                cur[i] = (cur[i] + pr) & 255
        rows.append(bytes(cur))
        prev = cur
    return w, h, channels, rows


def compare(actual, expected):
    aw, ah, ac, arows = read_png(actual)
    ew, eh, ec, erows = read_png(expected)
    if (aw, ah) != (ew, eh):
        return f"SIZE differs: actual {aw}x{ah}, expected {ew}x{eh}"
    changed, x0, y0, x1, y1 = 0, aw, ah, -1, -1
    for y in range(ah):
        ra, re = arows[y], erows[y]
        if ra == re and ac == ec:
            continue
        for x in range(aw):
            pa = ra[x * ac : x * ac + ac]
            pe = re[x * ec : x * ec + ec]
            if any(abs(i - j) > THRESHOLD for i, j in zip(pa, pe)):
                changed += 1
                x0, x1 = min(x0, x), max(x1, x)
                y0, y1 = min(y0, y), max(y1, y)
    total = aw * ah
    if not changed:
        return f"same ({aw}x{ah})"
    cx, cy = (x0 + x1) / 2 / aw, (y0 + y1) / 2 / ah
    where = ("top", "middle", "bottom")[min(2, int(cy * 3))] + "-" + ("left", "center", "right")[min(2, int(cx * 3))]
    return (
        f"DIFFERENT ({aw}x{ah}): {changed} px, {changed / total:.4%} of the image. "
        f"Changed area x={x0}..{x1} y={y0}..{y1} ({x1 - x0 + 1}x{y1 - y0 + 1}), mostly {where}."
    )


def pairs(folder):
    for root, _, files in os.walk(folder):
        for name in sorted(files):
            if name.endswith("-actual.png"):
                base = name[: -len("-actual.png")]
                expected = os.path.join(root, base + "-expected.png")
                if os.path.exists(expected):
                    yield os.path.join(root, base), os.path.join(root, name), expected


def main(args):
    if len(args) == 2 and all(a.endswith(".png") for a in args):
        print(compare(args[0], args[1]))
        return 0
    if len(args) == 1 and os.path.isdir(args[0]):
        found = 0
        for label, actual, expected in pairs(args[0]):
            found += 1
            try:
                print(f"{os.path.relpath(label, args[0])}: {compare(actual, expected)}")
            except (ValueError, OSError, zlib.error) as e:
                print(f"{os.path.relpath(label, args[0])}: cannot read ({e})")
        if not found:
            print("no *-actual.png with a matching *-expected.png found")
        return 0
    print("usage: crew-visual-diff <test-results folder>\n       crew-visual-diff <actual.png> <expected.png>", file=sys.stderr)
    return 2


sys.exit(main(sys.argv[1:]))
